// The Pizarra Futnorte IA — modelo de datos

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum MessageRole {
  user
  assistant
}

enum AssistantMode {
  GENERAL
  ENTRENADOR
  ARBITRO
  ANALISTA
}

/// Perfil de la app. id = auth.users.id de Supabase Auth.
model Profile {
  id            String         @id @db.Uuid
  email         String         @unique
  name          String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]

  @@map("profiles")
}

model Conversation {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  title     String        @default("Nueva conversación")
  mode      AssistantMode @default(GENERAL)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole
  content        String
  model          String?
  tokens         Int?
  latencyMs      Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Configuración del asistente (fila única, id = 1). Editable por ADMIN.
model AssistantConfig {
  id           Int      @id @default(1)
  systemPrompt String
  model        String   @default("openai/gpt-oss-120b")
  temperature  Float    @default(0.6)
  maxTokens    Int      @default(1024)
  historyLimit Int      @default(8)
  updatedAt    DateTime @updatedAt
  updatedBy    String?  @db.Uuid

  @@map("assistant_config")
}
